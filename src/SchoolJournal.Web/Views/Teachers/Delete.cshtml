@model TeacherEditDto
@{
    ViewData["Title"] = "Удаление учителя";
}
<h2>Удаление учителя</h2>
<div class="alert alert-warning">
    Вы действительно хотите удалить учителя <strong>@Model.FullName</strong>
    (@Model.QualificationCategory, нагрузка @Model.WorkloadHours ч)?
</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
</form>
