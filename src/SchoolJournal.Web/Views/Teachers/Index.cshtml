@model TeacherIndexViewModel
@{
    ViewData["Title"] = "Учителя";
    var f = Model.Filter;
    var routes = f.ToRouteValues("PageIndex", "SortOrder");
    Dictionary<string, string> Sort(string key, bool isDefault = false) =>
        routes.With("SortOrder", (f.SortOrder == key || (isDefault && string.IsNullOrEmpty(f.SortOrder))) ? key + "_desc" : key);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Учителя</h2>
    <a asp-action="Create" class="btn btn-success">Добавить учителя</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="SortOrder" value="@f.SortOrder" />
    <div class="col-md-5">
        <label class="form-label">ФИО</label>
        <input name="Search" value="@f.Search" class="form-control" placeholder="Часть фамилии или имени" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Квалификационная категория</label>
        <select name="Category" asp-items="Model.Categories" class="form-select">
            <option value="">— все —</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Применить</button>
        <a asp-action="Index" asp-route-reset="true" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th><a asp-action="Index" asp-all-route-data="@(Sort("name", true))">ФИО</a></th>
                <th><a asp-action="Index" asp-all-route-data="@(Sort("category"))">Категория</a></th>
                <th class="text-end"><a asp-action="Index" asp-all-route-data="@(Sort("workload"))">Нагрузка, ч</a></th>
                <th class="text-end">Классов</th>
                <th class="text-end">Уроков</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Result.Items)
            {
                <tr>
                    <td>@t.FullName</td>
                    <td>@t.QualificationCategory</td>
                    <td class="text-end">@t.WorkloadHours</td>
                    <td class="text-end">@t.ClassesCount</td>
                    <td class="text-end">@t.LessonsCount</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    </td>
                </tr>
            }
            @if (!Model.Result.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted">Ничего не найдено</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="@(new PagerViewModel(Model.Result.PageIndex, Model.Result.TotalPages, Model.Result.TotalCount, f.ToRouteValues("PageIndex")))" />
