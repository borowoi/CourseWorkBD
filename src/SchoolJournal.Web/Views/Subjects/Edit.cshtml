@model SubjectEditDto
@{
    ViewData["Title"] = "Изменение предмета";
}
<h2>Изменение предмета</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <partial name="_Form" model="Model" />
</form>
<p class="mt-3"><a asp-action="Hours" asp-route-id="@Model.Id">Нагрузка по часам в неделю</a></p>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
