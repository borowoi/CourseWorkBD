@model StudentIndexViewModel
@{
    ViewData["Title"] = "Учащиеся";
    var f = Model.Filter;
    var routes = f.ToRouteValues("PageIndex", "SortOrder");
    Dictionary<string, string> Sort(string key, bool isDefault = false) =>
        routes.With("SortOrder", (f.SortOrder == key || (isDefault && string.IsNullOrEmpty(f.SortOrder))) ? key + "_desc" : key);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Учащиеся</h2>
    <a asp-action="Create" class="btn btn-success">Добавить учащегося</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="SortOrder" value="@f.SortOrder" />
    <div class="col-md-4">
        <label class="form-label">ФИО</label>
        <input name="Search" value="@f.Search" class="form-control" placeholder="Часть фамилии или имени" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Параллель</label>
        <select name="GradeLevel" asp-items="Model.Grades" class="form-select">
            <option value="">— все —</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Класс</label>
        <select name="ClassId" asp-items="Model.Classes" class="form-select">
            <option value="">— все —</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Применить</button>
        <a asp-action="Index" asp-route-reset="true" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th><a asp-action="Index" asp-all-route-data="@(Sort("name", true))">ФИО</a></th>
                <th><a asp-action="Index" asp-all-route-data="@(Sort("birth"))">Дата рождения</a></th>
                <th><a asp-action="Index" asp-all-route-data="@(Sort("class"))">Класс</a></th>
                <th>Контактные данные</th>
                <th>Зачислен</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Result.Items)
            {
                <tr>
                    <td>@s.FullName</td>
                    <td>@s.BirthDate.ToString("dd.MM.yyyy")</td>
                    <td>@s.ClassName</td>
                    <td>@s.ContactInfo</td>
                    <td>@s.EnrollmentDate.ToString("dd.MM.yyyy")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    </td>
                </tr>
            }
            @if (!Model.Result.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted">Ничего не найдено</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="@(new PagerViewModel(Model.Result.PageIndex, Model.Result.TotalPages, Model.Result.TotalCount, f.ToRouteValues("PageIndex")))" />
